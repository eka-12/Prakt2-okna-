<Window x:Class="Prakt2_okna_.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prakt2_okna_"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid Margin="0,0,-21,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="729*"/>
            <ColumnDefinition Width="92*"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="lUser" Content="Label" HorizontalAlignment="Left" Margin="10,8,0,0" VerticalAlignment="Top" Height="46" Width="340" FontSize="24"/>
        <Label Content="Котировки" HorizontalAlignment="Left" Margin="677,206,0,0" VerticalAlignment="Top" Height="37" Width="136" FontSize="18" Grid.ColumnSpan="2"/>
        <Button x:Name="bQuotes" Content="Получить котировки" HorizontalAlignment="Left" Height="36" Margin="677,170,0,0" VerticalAlignment="Top" Width="119" Grid.ColumnSpan="2"/>
        <Button x:Name="bAnalys" Content="Провести анализ" HorizontalAlignment="Left" Height="38" Margin="677,119,0,0" VerticalAlignment="Top" Width="119" Grid.ColumnSpan="2"/>
        <Slider x:Name="sMarkup" HorizontalAlignment="Left" Margin="248,129,0,0" VerticalAlignment="Top" Width="202" Height="18" Background="Transparent" />
        <Label x:Name="lMarkup" Content="100%" HorizontalAlignment="Left" Margin="450,124,0,0" VerticalAlignment="Top" Height="26" Width="39"/>
        <Button x:Name="bMarkup" Content="Установить наценку" HorizontalAlignment="Left" Margin="513,119,0,0" VerticalAlignment="Top" Height="38" Width="145" />
        <Button x:Name="bAdd" Content="Добавить информацию" HorizontalAlignment="Left" Margin="663,59,0,0" VerticalAlignment="Top" Height="40" Width="136" Grid.ColumnSpan="2" />
        <Button x:Name="bUpdate" Content="Обновить БД" HorizontalAlignment="Left" Margin="16,121,0,0" VerticalAlignment="Top" Height="38" Width="136" />
        <TextBox x:Name="tbPosName" HorizontalAlignment="Left" Height="22" Margin="2,82,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="136"/>
        <ComboBox x:Name="cbPosType" HorizontalAlignment="Left" Margin="166,82,0,0" VerticalAlignment="Top" Width="136" Height="22"/>
        <TextBox x:Name="tbPosValue" HorizontalAlignment="Left" Margin="335,82,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="136" Height="22"/>
        <TextBox x:Name="tbPosPrice" HorizontalAlignment="Left" Margin="508,82,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="136" Height="22"/>
        <TextBlock HorizontalAlignment="Left" Margin="2,61,0,0" TextWrapping="Wrap" Text="Название товара" VerticalAlignment="Top" Width="136" Height="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="166,59,0,0" TextWrapping="Wrap" Text="Тип товара" VerticalAlignment="Top" Width="136" Height="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="335,61,0,0" TextWrapping="Wrap" Text="Количество товара" VerticalAlignment="Top" Width="136" Height="16"/>
        <TextBlock HorizontalAlignment="Left" Margin="508,61,0,0" TextWrapping="Wrap" Text="Цена за товар" VerticalAlignment="Top" Width="136" Height="16"/>
        <Border HorizontalAlignment="Left" Height="186" Margin="666,236,0,0" VerticalAlignment="Top" Width="130" Grid.ColumnSpan="2">
            <Border.Background>
                <SolidColorBrush Color="#FFF0F0F0" Opacity="1"/>
            </Border.Background>
            <Border.BindingGroup>
                <BindingGroup/>
            </Border.BindingGroup>
        </Border>
        <ListBox x:Name="tbQuotes" Margin="26,167,76,27"/>
        <DataGrid x:Name="dgMain" HorizontalAlignment="Left" Height="251" Margin="25,165,0,0" VerticalAlignment="Top" Width="635">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID товара" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="Название товара" Binding="{Binding Name}" Width="110"/>
                <DataGridTextColumn Header="Тип товара" Binding="{Binding Type}" Width="90"/>
                <DataGridTextColumn Header="Цена за товар" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="Цена в валюте" Binding="{Binding Quantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
