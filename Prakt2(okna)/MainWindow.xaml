<Window x:Class="Prakt2_okna_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prakt2_okna_"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="173*"/>
            <ColumnDefinition Width="27*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="bEnter" Content="Войти" HorizontalAlignment="Left" Margin="190,122,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Height="60" Width="160" Click="bEnter_Click"/>
        <Button x:Name="bRegistration" Content="Зарегистрироваться" HorizontalAlignment="Left" Margin="10,92,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Height="60" Width="160" Click="bRegistration_Click"/>
        <TextBox x:Name="tbLogin" HorizontalAlignment="Left" Margin="239,17,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="22" IsEnabled="False" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbPass1" HorizontalAlignment="Left" Margin="240,55,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="19" Grid.ColumnSpan="2"/>
        <TextBox x:Name="tbPass2" HorizontalAlignment="Left" Margin="240,89,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" Height="19" Grid.ColumnSpan="2"/>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="190,11,0,0" VerticalAlignment="Top" Height="27" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2" Width="51">
            <Label.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.348"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Label.RenderTransform>
        </Label>
        <Label Content="Пароль1" HorizontalAlignment="Left" Margin="183,49,0,0" VerticalAlignment="Top" Height="27" Grid.ColumnSpan="2" Width="58"/>
        <Label Content="Пароль2" HorizontalAlignment="Left" Margin="183,85,0,0" VerticalAlignment="Top" Height="27" Grid.ColumnSpan="2"/>
        <Button x:Name="bLogin" Content="Залогиниться" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="60" Width="160" Grid.ColumnSpan="2" Click="bLogin_Click"/>
    </Grid>
</Window>
